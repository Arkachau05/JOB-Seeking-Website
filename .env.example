# Copy this file to .env and replace every placeholder before starting Compose.
PORT=4000
FRONTEND_URL=http://localhost:5173

# Compose provisions a local MongoDB container with these credentials.
MONGO_ROOT_USERNAME=lookjobber
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

# Optional: set MONGO_URI to a managed MongoDB connection string for cloud
# deployments. If unset, Compose connects to its private authenticated MongoDB.
# MONGO_URI=mongodb+srv://...

# Replace with credentials from your own Cloudinary account (resume storage).
CLOUDINARY_CLIENT_NAME=your-cloud-name
CLOUDINARY_CLIENT_API=your-cloudinary-api-key
CLOUDINARY_CLIENT_SECRET=your-cloudinary-api-secret

# Replace with a unique, randomly generated signing secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE=1d
COOKIE_EXPIRE=1
COOKIE_SECURE=false
