PORT=4000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017

# Replace with a long, random value before using the application.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
COOKIE_SECURE=false

# Required only for resume uploads. Fill these from your Cloudinary account.
CLOUDINARY_CLIENT_NAME=your-cloud-name
CLOUDINARY_CLIENT_API=your-cloudinary-api-key
CLOUDINARY_CLIENT_SECRET=your-cloudinary-api-secret
